{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atomi.cloud/diene/diene-vendor-report-v1.schema.json",
  "title": "Diene declared-vendor action report v1",
  "description": "Evidence for one separately invoked vendor action. Existing report vocabulary remains valid; Namespace lifecycle and predecessor-chain evidence are additive for the active venue. Core readiness and journey fields remain forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "repositoryRevision", "workflow", "lane", "profile", "buildMode",
    "actionId", "componentClass", "permissionRule", "receiptId", "instance", "tooling",
    "vendorOutcome", "providerCleanup", "evidence", "teardown", "timings", "outcome"
  ],
  "properties": {
    "apiVersion": { "const": "diene.atomi.cloud/ci-vendor-report/v1" },
    "repositoryRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflow": { "$ref": "diene-environment-report-v1.schema.json#/$defs/workflow" },
    "lane": { "const": "ditto-vendor" },
    "profile": { "const": "ditto" },
    "buildMode": { "const": "build-local" },
    "actionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "componentClass": { "const": "K9" },
    "permissionRule": { "const": "ditto-vendor-demo" },
    "receiptId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "instance": { "$ref": "diene-environment-report-v1.schema.json#/$defs/instance" },
    "tooling": { "$ref": "diene-environment-report-v1.schema.json#/$defs/tooling" },
    "vendorOutcome": { "$ref": "diene-environment-report-v1.schema.json#/$defs/outcome" },
    "providerCleanup": { "$ref": "#/$defs/providerCleanup" },
    "credential": { "$ref": "#/$defs/credential" },
    "evidence": { "$ref": "diene-environment-report-v1.schema.json#/$defs/evidence" },
    "teardown": { "$ref": "diene-environment-report-v1.schema.json#/$defs/teardown" },
    "namespaceLifecycle": { "$ref": "diene-environment-report-v1.schema.json#/$defs/namespaceLifecycle" },
    "checkpointChain": { "$ref": "diene-environment-report-v1.schema.json#/$defs/checkpointChain" },
    "timings": { "$ref": "diene-environment-report-v1.schema.json#/$defs/timings" },
    "outcome": { "enum": ["Pass", "Fail", "NotApplicable", "Unavailable"] },
    "reasonCode": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "not": {
        "anyOf": [
          { "required": ["readiness"] },
          { "required": ["journeys"] },
          { "required": ["coverage"] },
          { "required": ["subject"] }
        ]
      }
    },
    {
      "if": {
        "properties": { "outcome": { "enum": ["Fail", "NotApplicable", "Unavailable"] } },
        "required": ["outcome"]
      },
      "then": { "required": ["reasonCode"] }
    },
    {
      "if": { "required": ["namespaceLifecycle"] },
      "then": {
        "required": ["checkpointChain"],
        "properties": {
          "instance": {
            "required": ["clusterId", "osId", "k3sVersion", "kubernetesVersion", "nodeCount", "capacity"]
          },
          "tooling": { "required": ["nscVersion", "sourceArchiveDigest", "artifactSubjectDigest"] },
          "evidence": {
            "required": ["proofBundle"],
            "properties": {
              "egressCanary": {
                "required": ["profileId", "enforcement", "platformStatus", "hostileProbes"]
              }
            }
          },
          "timings": {
            "required": [
              "createToKubernetesReadySeconds", "driverTransferSetupSeconds", "renderApplySeconds",
              "collectionSeconds", "destroySeconds", "totalColdSeconds"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "enum": ["Pass", "Unavailable"] } },
        "required": ["outcome", "namespaceLifecycle"]
      },
      "then": {
        "properties": {
          "providerCleanup": {
            "properties": { "outcome": { "const": "Pass" }, "absenceProven": { "const": true } }
          },
          "instance": {
            "properties": {
              "clusterId": { "type": "string" }, "osId": { "const": "wolfi" },
              "k3sVersion": { "type": "string" }, "kubernetesVersion": { "type": "string" },
              "nodeCount": { "const": 1 }, "capacity": { "type": "object" }
            }
          },
          "namespaceLifecycle": {
            "properties": {
              "outcome": { "const": "Pass" },
              "create": { "properties": { "outcome": { "const": "Pass" } } },
              "transfer": { "properties": { "outcome": { "const": "Pass" } } },
              "ssh": { "properties": { "outcome": { "const": "Pass" } } },
              "collection": { "properties": { "outcome": { "const": "Pass" } } },
              "destroy": { "properties": { "outcome": { "const": "Pass" } } },
              "absence": { "properties": { "outcome": { "const": "Pass" } } }
            }
          },
          "checkpointChain": {
            "properties": {
              "validated": { "const": true }, "resumedLegs": { "const": 0 }, "finalCleanPass": { "const": true }
            }
          },
          "evidence": {
            "properties": {
              "proofBundle": {
                "properties": { "outcome": { "const": "Pass" }, "collectedBeforeDestroy": { "const": true } }
              },
              "egressCanary": { "properties": { "outcome": { "const": "Pass" } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "Unavailable" } },
        "required": ["outcome", "namespaceLifecycle"]
      },
      "then": {
        "properties": {
          "vendorOutcome": {
            "properties": {
              "outcome": { "const": "Unavailable" },
              "required": { "const": false }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "providerCleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reasonCode", "objectIds", "absenceProven"],
      "properties": {
        "outcome": { "enum": ["Pass", "Fail", "Unavailable"] },
        "reasonCode": { "type": "string", "minLength": 1 },
        "objectIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "absenceProven": { "type": "boolean" },
        "durableDebtRecord": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "absenceProven": { "const": false } }, "required": ["absenceProven"] },
          "then": {
            "properties": { "durableDebtRecord": { "type": "string" } },
            "required": ["durableDebtRecord"]
          }
        }
      ]
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "masked", "issuedAfterReadiness", "removed", "removalObserved"],
      "properties": {
        "issuer": { "enum": ["host-owned-broker", "approved-environment-phase-broker"] },
        "masked": { "type": "boolean" },
        "issuedAfterReadiness": { "type": "boolean" },
        "removed": { "type": "boolean" },
        "removalObserved": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "removed": { "const": true } }, "required": ["removed"] },
          "then": { "properties": { "removalObserved": { "const": true } } }
        }
      ]
    }
  }
}
