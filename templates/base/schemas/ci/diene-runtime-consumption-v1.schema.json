{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atomi.cloud/diene/diene-runtime-consumption-v1.schema.json",
  "title": "Consumption view of the Garden-owned diene-runtime/v1 record",
  "description": "goals/garden-k3d-profiles.md §2 makes `pls` the sole writer of diene-runtime/v1. This node never writes that record. This schema is a strict subset assertion over the fields this CI node reads when it discovers a Garden-emitted runtime file; it is NOT a re-declaration of the Garden schema, so unknown Garden-owned fields are accepted. If a discovered record does not satisfy this view, the lane refuses RuntimeEvidenceUnavailable rather than forging a substitute.",
  "type": "object",
  "additionalProperties": true,
  "required": ["apiVersion", "profile", "buildMode", "owner", "substrate", "artifact"],
  "properties": {
    "apiVersion": { "const": "diene-runtime/v1" },
    "profile": { "enum": ["lapras", "ditto", "rotom", "absol", "eevee", "castform"] },
    "buildMode": { "enum": ["sync", "build-local", "target-pull"] },
    "owner": {
      "type": "object",
      "additionalProperties": true,
      "required": ["repositoryId", "repositoryKey", "allocationKey", "generationKey"],
      "properties": {
        "repositoryId": { "type": ["string", "integer"] },
        "repositoryKey": { "type": "string", "pattern": "^AtomiCloud/[A-Za-z0-9_.-]+$" },
        "allocationKey": { "type": "string", "minLength": 1 },
        "generationKey": { "type": "string", "minLength": 1 }
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "name", "receipt"],
      "properties": {
        "kind": { "const": "k3d" },
        "name": { "type": "string", "minLength": 1 },
        "receipt": { "type": "string", "minLength": 1 },
        "kubeconfig": { "type": "string", "pattern": "^/" },
        "context": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": true,
      "required": ["digest"],
      "properties": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
    }
  }
}
