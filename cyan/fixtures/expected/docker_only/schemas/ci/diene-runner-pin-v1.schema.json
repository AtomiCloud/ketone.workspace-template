{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atomi.cloud/diene/diene-runner-pin-v1.schema.json",
  "title": "Diene CI runner controller and image pin v1",
  "description": "The immutable controller release and runner image this repository is allowed to consume, together with the accepted RunnerProvisionerReady proof. No workspace caller may select or queue a disposable self-hosted runner before this declaration exists and validates, so a missing pin refuses on the GitHub-hosted authorization path rather than after a VM has already been allocated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "controller", "image", "provisionerReady"],
  "properties": {
    "apiVersion": { "const": "diene.atomi.cloud/ci-runner-pin/v1" },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "digest", "signatureDigest"],
      "properties": {
        "release": { "const": "diene-ci-runner/v1" },
        "digest": { "$ref": "#/$defs/digest" },
        "signatureDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest", "lockDigest"],
      "properties": {
        "name": { "const": "diene-k3d-isolated-v1" },
        "digest": { "$ref": "#/$defs/digest" },
        "lockDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "provisionerReady": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "evidenceDigest"],
      "properties": {
        "accepted": { "const": true },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
